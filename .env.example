# Copy to .env and adjust for local development only. Do not use these values in production.

# Practice database — reset/load only affect this database
MYSQL_DATABASE=leetcode

# Credentials (development defaults)
MYSQL_ROOT_PASSWORD=leetcode_root_dev
MYSQL_USER=leetcode
MYSQL_PASSWORD=leetcode_dev

# Host ports (change if 3306 or 8080 are already in use on your machine)
MYSQL_HOST_PORT=3306
PHPMYADMIN_HOST_PORT=8080

# Internal Docker DNS (CLI container uses these; do not set to localhost)
MYSQL_HOST=mysql
MYSQL_PORT=3306
